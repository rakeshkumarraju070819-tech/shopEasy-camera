# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Nginx, etc.) so req.ip is the real visitor IP
TRUST_PROXY=0

# ---- MongoDB Atlas ----
# Leave blank to run with a temporary in-memory store (data is lost on restart).
MONGODB_URI=

# ---- Admin authentication (REQUIRED) ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@camshield.local
ADMIN_PASSWORD=newgame@

# ---- IP intelligence (optional) ----
# Free token from https://ipinfo.io. If blank, ipapi.co's free endpoint is used.
IPINFO_TOKEN=

# ---- Development sample data ----
# Seeds clearly-labelled FICTIONAL visitor records (documentation IP ranges only).
SEED_SAMPLE_DATA=true
# Visitor records older than this are removed automatically (0 = never)
RETENTION_DAYS=30
